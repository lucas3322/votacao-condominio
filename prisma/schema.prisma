generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vote {
  id              String   @id @default(cuid())
  name            String
  phone           String
  apartment       String
  tower           String
  windowCount     Int
  hasBalcony      Boolean
  services        String[] @default([])
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tower, apartment])
}
