generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Choice {
  CURTAIN
  BLIND
  NONE
}

model Vote {
  id              String   @id @default(cuid())
  name            String
  phone           String
  apartment       String
  tower           String
  windowCount     Int
  windowChoice    Choice
  hasBalcony      Boolean
  balconyChoice   Choice?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tower, apartment])
  @@index([windowChoice])
}
